<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sw_background"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rvTasks"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sw_surface"
            app:strokeColor="@color/sw_red"
            app:strokeWidth="1dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crear Nueva Tarea"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/sw_red"
                    android:fontFamily="sans-serif-condensed"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etTaskTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título de la tarea"
                    android:textColorHint="@color/sw_text_secondary"
                    android:textColor="@color/sw_text_primary"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginBottom="8dp"/>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <TableRow
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:text="Categoría:"
                            android:fontFamily="sans-serif-condensed"
                            android:textColor="@color/sw_text_secondary"
                            android:paddingEnd="8dp"/>
                        <Spinner
                            android:id="@+id/spinnerCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/task_categories"
                            android:theme="@style/Theme.TaskMaster"/>
                    </TableRow>

                    <TableRow
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:text="Prioridad:"
                            android:fontFamily="sans-serif-condensed"
                            android:textColor="@color/sw_text_secondary"
                            android:paddingEnd="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgPriority"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/rbHigh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/sw_text_primary"
                                android:fontFamily="sans-serif-condensed"
                                android:text="Alta"/>
                            <RadioButton
                                android:id="@+id/rbLow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/sw_text_primary"
                                android:fontFamily="sans-serif-condensed"
                                android:text="Baja"/>
                        </RadioGroup>
                    </TableRow>
                </TableLayout>

                <CheckBox
                    android:id="@+id/cbReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sw_text_primary"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Agregar recordatorio"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sw_text_secondary"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Progreso inicial:"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="20"
                    android:progressTint="@color/sw_red"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sw_text_secondary"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Importancia:"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1.0"
                    android:progressTint="@color/sw_red"
                    android:secondaryProgressTint="@color/sw_red_dark"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnSaveTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.1"
                    android:text="Guardar Tarea"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/scrollView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3"/>

</androidx.constraintlayout.widget.ConstraintLayout>
