<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TaskMaster" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Star Wars Theme Customization -->
        <item name="colorPrimary">@color/sw_red</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/sw_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/sw_accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/sw_background</item>
        <item name="colorOnBackground">@color/sw_text_primary</item>

        <item name="colorSurface">@color/sw_surface</item>
        <item name="colorOnSurface">@color/sw_text_primary</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/sw_text_primary</item>
        <item name="android:textColorSecondary">@color/sw_text_secondary</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/sw_background</item>

        <!-- For standard Buttons -->
        <item name="materialButtonStyle">@style/Widget.TaskMaster.Button</item>
    </style>

    <style name="Theme.TaskMaster" parent="Base.Theme.TaskMaster" />

    <!-- Custom Button Style -->
    <style name="Widget.TaskMaster.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sw_background</item>
        <item name="strokeColor">@color/sw_red</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/sw_red</item>
        <item name="cornerRadius">0dp</item>
    </style>
</resources>